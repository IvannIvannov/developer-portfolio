# Server
PORT=5000
CORS_ORIGINS=http://localhost:5173

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password

# Contact
